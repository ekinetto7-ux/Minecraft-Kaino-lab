<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>遊び用レジアプリ（割引付き）</title>
    <style>
        body {
            font-family: sans-serif;
            background: #f4f6f9;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 400px;
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        h2 { text-align: center; color: #333; }
        .screen {
            background: #222;
            color: #0f0;
            font-size: 28px;
            text-align: right;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-family: monospace;
        }
        .section-title { font-weight: bold; margin-bottom: 10px; color: #555; }
        .item-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }
        button {
            padding: 12px;
            font-size: 15px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
        .item-btn { background: #e0f2fe; color: #0369a1; }
        .discount-btn { background: #fef3c7; color: #d97706; }
        
        .action-area { display: flex; gap: 10px; margin-bottom: 20px; }
        .clear-btn { background: #fee2e2; color: #991b1b; flex: 1; }
        .checkout-btn { background: #dcfce7; color: #166534; flex: 2; }

        .payment-area {
            display: none;
            border-top: 2px dashed #ddd;
            padding-top: 15px;
        }
        .pay-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .pay-mana { background: #fef08a; color: #854d0e; }
        .pay-cash { background: #e2e8f0; color: #334155; }
        .pay-curios { background: #f3e8ff; color: #6b21a8; }
        .cancel-btn { background: #f1f5f9; color: #64748b; margin-top: 5px; }

        .message {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            color: #16a34a;
            margin-top: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>お遊びレジ</h2>
    
    <!-- 合計金額表示画面 -->
    <div class="screen" id="display">¥0</div>

    <!-- 商品ボタン -->
    <div class="section-title">商品を選ぶ</div>
    <div class="item-grid">
        <button class="item-btn" onclick="addItem(100)">商品A (¥100)</button>
        <button class="item-btn" onclick="addItem(300)">商品B (¥300)</button>
        <button class="item-btn" onclick="addItem(500)">商品C (¥500)</button>
        <button class="item-btn" onclick="addItem(1000)">商品D (¥1000)</button>
    </div>

    <!-- 割引ボタン -->
    <div class="section-title">割引</div>
    <div class="item-grid">
        <button class="discount-btn" onclick="applyDiscount(100)">-100円引き</button>
        <button class="discount-btn" onclick="applyFullDiscount()">全額（無料）</button>
    </div>

    <!-- 操作ボタン -->
    <div class="action-area">
        <button class="clear-btn" onclick="resetTotal()">リセット</button>
        <button class="checkout-btn" onclick="showPayment()">会計に進む</button>
    </div>

    <!-- 支払い方法選択エリア -->
    <div class="payment-area" id="paymentArea">
        <div class="section-title">支払い方法を選択</div>
        <div class="pay-grid">
            <button class="pay-mana" onclick="pay('Manaカード')">💎 Manaカード</button>
            <button class="pay-cash" onclick="pay('現金')">💵 現金</button>
            <button class="pay-curios" onclick="pay('curios')">🔮 curios</button>
            <button class="cancel-btn" onclick="hidePayment()">戻る</button>
        </div>
    </div>

    <!-- 完了メッセージ -->
    <div class="message" id="message"></div>
</div>

<script>
    let total = 0;

    function addItem(price) {
        total += price;
        updateDisplay();
        document.getElementById('message').innerText = "";
    }

    function applyDiscount(amount) {
        total -= amount;
        if (total < 0) total = 0; // マイナスにならないようにする
        updateDisplay();
        document.getElementById('message').innerText = "";
    }

    function applyFullDiscount() {
        total = 0;
        updateDisplay();
        document.getElementById('message').innerText = "全額割引が適用されました！";
    }

    function updateDisplay() {
        document.getElementById('display').innerText = "¥" + total.toLocaleString();
    }

    function resetTotal() {
        total = 0;
        updateDisplay();
        document.getElementById('message').innerText = "";
        hidePayment();
    }

    function showPayment() {
        if (total === 0) {
            // 全額割引などで0円になっている場合はそのまま会計に進めるかメッセージを出す
            document.getElementById('paymentArea').style.display = "block";
            return;
        }
        document.getElementById('paymentArea').style.display = "block";
    }

    function hidePayment() {
        document.getElementById('paymentArea').style.display = "none";
    }

    function pay(method) {
        document.getElementById('message').innerText = `【${method}】で ¥${total.toLocaleString()} のお会計完了！`;
        hidePayment();
        total = 0;
        updateDisplay();
    }
</script>

</body>
</html>
